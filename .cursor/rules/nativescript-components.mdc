## List Item (para ListView)

```xml
<!-- Item simples com chevron -->
<GridLayout columns="*, auto" class="list-item">
  <Label col="0" text="Configurações" class="text-base text-foreground" />
  <Label col="1" text="›" class="text-lg text-muted-foreground" />
</GridLayout>

<!-- Item com subtítulo -->
<GridLayout rows="auto, auto" columns="*, auto" class="list-item">
  <Label row="0" col="0" text="João Silva" class="text-base font-medium text-foreground" />
  <Label row="1" col="0" text="joao@email.com" class="text-sm text-muted-foreground mt-1" />
  <Label row="0" col="1" rowSpan="2" text="›" class="text-lg text-muted-foreground" verticalAlignment="center" />
</GridLayout>

<!-- Item com avatar (iniciais) -->
<GridLayout rows="auto, auto" columns="auto, *, auto" class="list-item">
  <Label row="0" col="0" rowSpan="2" text="JS"
    class="text-sm font-bold text-primary-foreground bg-primary w-10 h-10 rounded-full text-center"
    verticalAlignment="center" />
  <Label row="0" col="1" text="João Silva" class="text-base font-medium text-foreground ml-3" />
  <Label row="1" col="1" text="Cliente VIP" class="text-sm text-muted-foreground ml-3" />
  <Label row="0" col="2" rowSpan="2" text="›" class="text-lg text-muted-foreground" verticalAlignment="center" />
</GridLayout>

<!-- Item com badge -->
<GridLayout columns="*, auto" class="list-item">
  <Label col="0" text="Pedido #1234" class="text-base font-medium text-foreground" />
  <Label col="1" text="Pago" class="badge-success" />
</GridLayout>

<!-- Item com preço -->
<GridLayout rows="auto, auto" columns="*, auto" class="list-item">
  <Label row="0" col="0" :text="item.name" class="text-base font-medium text-foreground" textWrap="true" />
  <Label row="0" col="1" :text="formatCurrency(item.price)" class="text-base font-bold text-success" />
  <Label row="1" col="0" :text="item.category" class="text-xs text-muted-foreground mt-1" />
</GridLayout>
```

## Quantity Stepper

```xml
<GridLayout columns="auto, auto, auto" class="mt-2">
  <Button col="0" text="−" class="btn-icon-sm bg-secondary text-secondary-foreground" @tap="decrease(item)" />
  <Label col="1" :text="String(item.quantity)" class="text-base font-semibold text-foreground text-center min-w-8 mx-2" verticalAlignment="center" />
  <Button col="2" text="+" class="btn-icon-sm bg-primary text-primary-foreground" @tap="increase(item)" />
</GridLayout>
```

