# Catálogo de Componentes — NativeScript-Vue 3

Referência para criar componentes de UI. Usa as classes `@utility` definidas no `app/app.css`.
Para detalhes sobre tokens e CSS do NativeScript, consulte `shadcn-nativescript.mdc`.

## Button

Todas as variantes usam a classe correspondente. Sobrescreva com utilities individuais se precisar.

```xml
<!-- Primary -->
<Button text="Confirmar" class="btn-primary" @tap="onConfirm" />

<!-- Secondary -->
<Button text="Cancelar" class="btn-secondary" @tap="onCancel" />

<!-- Outline -->
<Button text="Detalhes" class="btn-outline" @tap="onDetails" />

<!-- Ghost -->
<Button text="Voltar" class="btn-ghost" @tap="onBack" />

<!-- Destructive -->
<Button text="Excluir" class="btn-destructive" @tap="onDelete" />

<!-- Icon (circular 40dp) -->
<Button text="+" class="btn-icon" @tap="onAdd" />

<!-- Disabled — isEnabled + opacity -->
<Button text="Indisponível" class="btn-primary opacity-50" :isEnabled="false" />
```

### Sobrescrevendo variantes

```xml
<!-- Primary com texto maior -->
<Button text="Continuar" class="btn-primary text-lg p-4" @tap="onContinue" />

<!-- Outline com fundo accent ao ser usado como seleção -->
<Button text="Selecionado" class="btn-outline bg-accent" @tap="onSelect" />
```

## Card

```xml
<!-- Card básico -->
<GridLayout rows="auto, auto" class="card m-2">
  <Label row="0" text="Título" class="text-lg font-semibold text-card-foreground" />
  <Label row="1" text="Descrição" class="text-sm text-muted-foreground mt-1" textWrap="true" />
</GridLayout>

<!-- Card com ação -->
<GridLayout rows="auto, auto, auto" class="card m-2">
  <Label row="0" text="Pedido #1234" class="text-lg font-semibold text-card-foreground" />
  <Label row="1" text="3 itens · R$ 45,00" class="text-sm text-muted-foreground mt-1" />
  <Button row="2" text="Ver Detalhes" class="btn-primary mt-3" @tap="onViewOrder" />
</GridLayout>

<!-- Card de produto com preço -->
<GridLayout rows="auto, auto" columns="*, auto" class="card m-2">
  <Label row="0" col="0" :text="product.name" class="text-base font-semibold text-card-foreground" textWrap="true" />
  <Label row="0" col="1" :text="formatCurrency(product.price)" class="text-base font-bold text-success" />
  <Label row="1" col="0" :text="product.sku + ' · ' + product.product_category.name" class="text-xs text-muted-foreground mt-1" />
</GridLayout>

<!-- Card com elevação (exceção ao flat) -->
<GridLayout rows="auto" class="card m-2" androidElevation="2" iosElevation="2">
  <Label text="Card com sombra" class="text-base text-card-foreground" />
</GridLayout>
```

## Input / TextField

NativeScript não suporta `:focus` CSS. Para highlight de foco, use `@focus`/`@blur` com classe dinâmica.

### Classes disponíveis

- `input-field` — Estado normal (borda `border-input`, 1px)
- `input-focused` — Estado focado (borda `border-primary`, 2px)
- `input-search` — Busca com fundo muted

### Padrão de foco (recomendado)

```typescript
const focusedField = ref('');

function inputClass(field: string): string {
  return focusedField.value === field ? 'input-focused' : 'input-field';
}
```

```xml
<!-- Input com highlight de foco -->
<StackLayout class="mb-4">
  <Label text="E-mail" class="text-sm font-medium text-foreground mb-1" />
  <TextField
    v-model="email"
    hint="seu@email.com"
    keyboardType="email"
    :class="inputClass('email')"
    placeholderColor="#a1a1aa"
    @focus="focusedField = 'email'"
    @blur="focusedField = ''"
  />
</StackLayout>
```

### Outros inputs

```xml
<!-- Input sem foco dinâmico (quando não precisa) -->
<TextField v-model="name" hint="Nome completo" class="input-field" placeholderColor="#a1a1aa" />

<!-- Input de busca -->
<TextField v-model="searchQuery" hint="Buscar..." class="input-search" placeholderColor="#a1a1aa" @textChange="onSearch" />

<!-- Input senha -->
<TextField v-model="password" hint="Senha" :secure="true" class="input-field" placeholderColor="#a1a1aa" />

<!-- TextView (multiline) -->
<TextView v-model="notes" hint="Observações..." class="input-field" height="100" />
```

