# Crie um arquivo .env por ambiente na raiz do projeto.
# O webpack carrega o arquivo correto no build via --env.appEnv.
# Valores entram no bundle (build-time) — não coloque segredos aqui.
#
# Arquivos esperados:
#   .env.development   → npm run dev
#   .env.staging       → npm run build:staging
#   .env.production    → npm run build:production

# ── .env.development ─────────────────────────────────────────
# NS_CURRENT_ENV=development
# SCANCODE_API_URL=http://192.168.1.100:80

# ── .env.staging ─────────────────────────────────────────────
# NS_CURRENT_ENV=staging
# SCANCODE_API_URL=https://staging-api.example.com

# ── .env.production ──────────────────────────────────────────
# NS_CURRENT_ENV=production
# SCANCODE_API_URL=https://api.example.com
